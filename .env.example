DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=swarup_app
DATABASE_PASSWORD=change-me
DATABASE_NAME=swarup_jewellers
# Long random string used to sign admin sessions.
SESSION_SECRET=change-me
# Where uploaded and migrated product images live (persists across deploys).
UPLOAD_DIR=/var/www/swarup-jewellers/shared/uploads
SITE_URL=https://swarup.rasatech.in
# Used only by `npm run db:seed` to create the first admin account.
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-me
